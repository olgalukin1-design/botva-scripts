
(function () {
    "use strict";

    // Останавливаем предыдущую версию, если она запущена
    if (window.lunarTrackerStop) {
        window.lunarTrackerStop();
    }

    const state = {
        stages: [],
        players: new Set(),
        playerOrder: [],
        data: {},
        stats: {},
        allies: new Set()
    };

    const container = document.createElement("div");

    Object.assign(container.style, {
        position: "fixed",
        left: "50%",
        bottom: "15px",
        transform: "translateX(-50%)",
        background: "#111",
        color: "#fff",
        border: "1px solid #666",
        borderRadius: "6px",
        zIndex: "99999",
        fontFamily: "Arial, sans-serif",
        fontSize: "12px",
        boxShadow: "0 4px 20px rgba(0,0,0,.7)",
        maxWidth: "95vw"
    });

    const header = document.createElement("div");

    Object.assign(header.style, {
        background: "#292929",
        padding: "7px 10px",
        cursor: "move",
        display: "flex",
        justifyContent: "space-between",
        alignItems: "center",
        gap: "20px",
        userSelect: "none",
        borderRadius: "6px 6px 0 0"
    });

    const title = document.createElement("span");
    title.textContent = "На орбиту — противники";
    title.style.fontWeight = "bold";

    const buttons = document.createElement("div");
    buttons.style.display = "flex";
    buttons.style.gap = "8px";

    function makeButton(text, tooltip) {
        const btn = document.createElement("button");
        btn.textContent = text;
        btn.title = tooltip;

        Object.assign(btn.style, {
            background: "#444",
            color: "white",
            border: "1px solid #666",
            borderRadius: "3px",
            cursor: "pointer",
            padding: "2px 7px"
        });

        return btn;
    }

    const minimizeBtn = makeButton("−", "Свернуть");
    const closeBtn = makeButton("×", "Закрыть");

    buttons.append(minimizeBtn, closeBtn);
    header.append(title, buttons);

    const content = document.createElement("div");

    Object.assign(content.style, {
        padding: "8px",
        overflow: "auto",
        maxHeight: "65vh",
        maxWidth: "90vw"
    });

    container.append(header, content);
    document.body.appendChild(container);

    // =========================================
    // ПЕРЕТАСКИВАНИЕ ОКНА
    // =========================================

    let dragging = false;
    let offsetX = 0;
    let offsetY = 0;

    function startDrag(e) {
        if (e.target.closest("button")) return;

        const rect = container.getBoundingClientRect();

        container.style.left = rect.left + "px";
        container.style.top = rect.top + "px";
        container.style.bottom = "auto";
        container.style.transform = "none";

        offsetX = e.clientX - rect.left;
        offsetY = e.clientY - rect.top;

        dragging = true;
        e.preventDefault();
    }

    function moveDrag(e) {
        if (!dragging) return;

        const maxX = Math.max(
            0,
            window.innerWidth - container.offsetWidth
        );

        const maxY = Math.max(
            0,
            window.innerHeight - header.offsetHeight
        );

        const x = Math.max(
            0,
            Math.min(e.clientX - offsetX, maxX)
        );

        const y = Math.max(
            0,
            Math.min(e.clientY - offsetY, maxY)
        );

        container.style.left = x + "px";
        container.style.top = y + "px";
    }

    function stopDrag() {
        dragging = false;
    }

    header.addEventListener("mousedown", startDrag);
    document.addEventListener("mousemove", moveDrag);
    document.addEventListener("mouseup", stopDrag);

    // =========================================
    // КНОПКИ
    // =========================================

    let minimized = false;

    minimizeBtn.onclick = function () {
        minimized = !minimized;
        content.style.display = minimized ? "none" : "block";
        minimizeBtn.textContent = minimized ? "+" : "−";
    };

    closeBtn.onclick = function () {
        window.lunarTrackerStop();
    };

    // =========================================
    // БЕЗОПАСНЫЙ ВЫВОД ИМЁН
    // =========================================

    function escapeHTML(value) {
        return String(value)
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;")
            .replace(/'/g, "&#39;");
    }

    // =========================================
    // ЭТАПЫ
    // =========================================

    function parseStage() {
        return document
            .querySelector(".lunar_stage span")
            ?.textContent.trim();
    }

    // =========================================
    // ИГРОКИ
    // =========================================

    function addPlayer(name, isAlly = false) {
        if (!name || name === "[NAME]" || name.length < 2) {
            return;
        }

        if (!state.players.has(name)) {
            state.players.add(name);
            state.playerOrder.push(name);
        }

        if (isAlly) {
            state.allies.add(name);
        }
    }

    function parsePlayers() {

        // Сначала определяем союзников
        document.querySelectorAll(
            ".lunar_allies .lunar_name"
        ).forEach(el => {
            addPlayer(el.textContent.trim(), true);
        });

        // Затем определяем противников
        document.querySelectorAll(
            ".lunar_enemies .lunar_name"
        ).forEach(el => {
            addPlayer(el.textContent.trim(), false);
        });
    }

    // =========================================
    // СТАТИСТИКА БЕЗ ПОВТОРНОГО ПОДСЧЁТА
    // =========================================

    function saveSkill(stage, player, iconClass) {

        if (!stage || !player || !iconClass) return;
        if (iconClass === "icon_lunar_skill0") return;

        if (!state.data[stage]) {
            state.data[stage] = {};
        }

        const previous = state.data[stage][player];

        // Умение не изменилось — ничего не делаем
        if (previous?.skill === iconClass) {
            return;
        }

        // Заменяем старое умение новым
        state.data[stage][player] = {
            skill: iconClass
        };

        // Пересчитываем статистику по сохранённым этапам
        rebuildStats();
    }

    function rebuildStats() {

        state.stats = {};

        for (const stage of state.stages) {
            const stageData = state.data[stage] || {};

            for (const [player, record] of
                Object.entries(stageData)) {

                if (!state.stats[player]) {
                    state.stats[player] = {};
                }

                const skill = record.skill;

                state.stats[player][skill] =
                    (state.stats[player][skill] || 0) + 1;
            }
        }
    }

    // =========================================
    // СЧИТЫВАНИЕ УМЕНИЙ ПРОТИВНИКОВ
    // =========================================

    function parseActions(stage) {

        const enemies = new Set(
            state.playerOrder.filter(
                p => !state.allies.has(p)
            )
        );

        // Читаем журнал боя
        document.querySelectorAll(
            ".lunar_log_row"
        ).forEach(row => {

            const player = row.querySelector(
                "b:not([class])"
            )?.textContent.trim();

            if (!player || !enemies.has(player)) {
                return;
            }

            const icon = row.querySelector(".icon2");
            if (!icon) return;

            const iconClass = [...icon.classList].find(
                c => /^icon_lunar_skill\d+$/.test(c)
            );

            if (!iconClass) return;

            saveSkill(stage, player, iconClass);
        });
    }

    // =========================================
    // ПОДСКАЗКА СО СТАТИСТИКОЙ
    // =========================================

    function buildTooltip(player) {

        const stats = state.stats[player];
        if (!stats) return "";

        return Object.entries(stats)
            .map(([skill, count]) => {
                return skill.replace("icon_lunar_skill", "Умение ")
                    + ": " + count;
            })
            .join("\n");
    }

    // =========================================
    // ТАБЛИЦА — ТОЛЬКО ПРОТИВНИКИ
    // =========================================

    function render() {

        const enemies = state.playerOrder
            .filter(p => !state.allies.has(p))
            .slice(0, 5);

        const stages = state.stages;

        let html = `
            <table style="
                border-collapse:collapse;
                text-align:center;
                background:#111;
                color:#fff;
                white-space:nowrap;
            ">
        `;

        html += `
            <tr>
                <th style="
                    border:1px solid #777;
                    padding:5px 12px;
                ">Игрок</th>
        `;

        stages.forEach(stage => {
            html += `
                <th style="
                    border:1px solid #777;
                    padding:5px;
                    min-width:27px;
                ">${escapeHTML(stage)}</th>
            `;
        });

        html += "</tr>";

        enemies.forEach(player => {

            const tooltip = buildTooltip(player);

            html += "<tr>";

            html += `
                <td title="${escapeHTML(tooltip)}"
                    style="
                        border:1px solid #777;
                        padding:5px 10px;
                        font-weight:bold;
                    ">
                    ${escapeHTML(player)}
                </td>
            `;

            stages.forEach(stage => {

                const skill = state.data[stage]?.[player]?.skill;

                const icon = skill
                    ? `<b class="icon2 ${skill}"></b>`
                    : "";

                html += `
                    <td style="
                        border:1px solid #777;
                        padding:5px;
                        min-width:27px;
                        height:27px;
                    ">
                        ${icon}
                    </td>
                `;
            });

            html += "</tr>";
        });

        html += "</table>";

        if (!enemies.length) {
            html = `
                <div style="padding:12px;color:#aaa">
                    Ожидание противников...
                </div>
            `;
        }

        content.innerHTML = html;
    }

    // =========================================
    // ОБНОВЛЕНИЕ
    // =========================================

    function tick() {

        const stage = parseStage();
        if (!stage) return;

        if (!state.stages.includes(stage)) {
            state.stages.push(stage);
        }

        parsePlayers();
        parseActions(stage);
        render();
    }

    const interval = setInterval(tick, 5000);

    // Делаем остановку доступной извне
    window.lunarTrackerStop = function () {

        clearInterval(interval);

        header.removeEventListener(
            "mousedown", startDrag
        );

        document.removeEventListener(
            "mousemove", moveDrag
        );

        document.removeEventListener(
            "mouseup", stopDrag
        );

        container.remove();

        delete window.lunarTracker;
        delete window.lunarTrackerStop;
    };

    window.lunarTracker = interval;

    // Первое считывание сразу
    tick();

})();
