
(()=>{
'use strict';

const KEY='lunarTrackerV2';
const OLD=window[KEY];

if(OLD?.version===8){
    OLD.destroy();
    return;
}

const previous=OLD?.getData?.();
OLD?.destroy?.();

if(window.LunarTotalOverlay?.destroy){
    window.LunarTotalOverlay.destroy();
}

if(window.lunarTracker?.destroy){
    window.lunarTracker.destroy();
}

if(!document.querySelector('.lunar_stage')){
    alert('Открой окно боя с ракетами!');
    return;
}

const clean=s=>String(s||'').replace(/\s+/g,' ').trim();
const players=new Map();
const events=new Map();
const rowStages=new WeakMap();
const names=new Map();
const panels=new Map();
const stageSnapshots=new Map();

let stage=null;
let running=true;
let firstRead=true;
let timer=null;
let observer=null;
let warning='';
let busy=false;
let startedAt=Date.now();

const root=document.createElement('div');
root.id='lunar-total-v8';
root.style.cssText=
    'position:absolute;left:0;top:0;'+
    'width:0;height:0;z-index:2147483646;'+
    'pointer-events:none;';

document.body.appendChild(root);

function readPlayers(){
    const blocks=[
        ...document.querySelectorAll(
            '.lunar_enemies .user_block'
        )
    ].slice(0,5);

    blocks.forEach((block,index)=>{
        const name=clean(
            block.querySelector('.lunar_name')?.textContent
        );

        if(!name||name==='[NAME]')return;

        players.set(name,{
            name,
            id:block.dataset.id||'',
            side:'enemies',
            index
        });
    });

    document.querySelectorAll(
        '.lunar_controls [data-skill]'
    ).forEach(el=>{
        const id=Number(el.dataset.skill);
        const title=/subject:\|([^|]+)\|/.exec(
            el.getAttribute('onmouseover')||''
        )?.[1];

        if(id>0&&title)names.set(id,title);
    });

    return blocks;
}

function getStage(){
    const raw=clean(
        document.querySelector(
            '.lunar_stage span'
        )?.textContent
    );

    return /^\d+$/.test(raw)?Number(raw):null;
}

function isChoosing(){
    return [
        ...document.querySelectorAll(
            '.lunar_allies .user_block'
        )
    ].some(block=>{
        const item=block.querySelector('.item_box');
        return item&&!item.classList.contains('disabled');
    });
}

function readLog(){
    const rows=[
        ...document.querySelectorAll(
            '.lunar_log .lunar_log_row'
        )
    ];

    const current=getStage();
    if(current===null)return;

    if(stage!==null&&current<stage){
        running=false;
        warning='Этап уменьшился. Возможно, начался новый бой.';
        return;
    }

    stage=current;
    const initialStage=firstRead&&isChoosing()
        ?current-1:current;

    const observed=new Map();

    for(const row of rows){
        const icon=[
            ...row.querySelectorAll('.icon2')
        ].find(el=>[
            ...el.classList
        ].some(c=>/^icon_lunar_skill[1-9]\d*$/.test(c)));

        if(!icon)continue;

        const cls=[...icon.classList].find(
            c=>/^icon_lunar_skill[1-9]\d*$/.test(c)
        );

        const skill=Number(
            cls.replace('icon_lunar_skill','')
        );

        const actor=[
            ...row.querySelectorAll('b')
        ].find(el=>!el.classList.length);

        const player=clean(actor?.textContent);

        if(!players.has(player))continue;

        if(!rowStages.has(row)){
            rowStages.set(row,initialStage);
        }

        const eventStage=rowStages.get(row);
        if(eventStage<1)continue;

        const title=clean(icon.getAttribute('title'));
        if(title)names.set(skill,title);

        const text=clean(row.textContent);

        const base=JSON.stringify([
            eventStage,player,skill,text
        ]);

        const n=(observed.get(base)||0)+1;
        observed.set(base,n);

        for(let occurrence=1;occurrence<=n;occurrence++){
            const key=JSON.stringify([base,occurrence]);

            if(!events.has(key)){
                events.set(key,{
                    stage:eventStage,
                    player,
                    skill,
                    text
                });
            }
        }
    }

    firstRead=false;
}

function getCounts(player){
    const counts=new Map();

    for(const event of events.values()){
        if(event.player!==player)continue;

        counts.set(
            event.skill,
            (counts.get(event.skill)||0)+1
        );
    }

    return [...counts.entries()].sort(
        (a,b)=>a[0]-b[0]
    );
}

function makePanel(name){
    const panel=document.createElement('div');

    panel.style.cssText=[
        'position:absolute',
        'min-width:78px',
        'max-width:110px',
        'background:rgba(10,10,15,.94)',
        'border:1px solid #51482d',
        'border-radius:5px',
        'padding:5px',
        'color:white',
        'font:12px Arial,sans-serif',
        'box-shadow:0 3px 12px #0009',
        'pointer-events:none',
        'box-sizing:border-box'
    ].join(';');

    const heading=document.createElement('div');
    heading.textContent='Всего';
    heading.style.cssText=
        'color:#ffd447;font-size:14px;'+
        'font-weight:bold;text-align:center;'+
        'margin-bottom:4px;';

    const content=document.createElement('div');
    content.style.cssText=
        'display:flex;flex-direction:column;gap:2px;';

    panel.append(heading,content);
    root.appendChild(panel);

    const item={panel,content,signature:''};
    panels.set(name,item);

    return item;
}

function createSkill(id,count){
    const row=document.createElement('div');
    row.style.cssText=
        'display:flex;align-items:center;'+
        'justify-content:space-between;'+
        'gap:6px;min-height:25px;';

    const icon=document.createElement('b');
    icon.className='icon2 icon_lunar_skill'+id;

    icon.style.cssText=
        'display:inline-block;position:relative;'+
        'float:none;flex-shrink:0;margin:0;';

    const number=document.createElement('span');
    number.textContent=count;
    number.style.cssText=
        'color:#42e34d;font-size:13px;'+
        'font-weight:bold;min-width:12px;'+
        'text-align:right;';

    row.title=(names.get(id)||'Умение '+id)+
        ' — '+count+' применений';

    row.append(icon,number);
    return row;
}

function positionPanel(panel,block){
    const rect=block.getBoundingClientRect();

    const width=panel.offsetWidth||86;
    const height=panel.offsetHeight||40;

    const left=rect.right+window.scrollX-width-3;
    const top=rect.top+window.scrollY+70;

    panel.style.left=Math.max(0,left)+'px';
    panel.style.top=Math.max(0,top)+'px';
}

function render(){
    const blocks=readPlayers();
    const visible=new Set();

    blocks.forEach(block=>{
        const name=clean(
            block.querySelector('.lunar_name')?.textContent
        );

        if(!name||!players.has(name))return;

        visible.add(name);

        const item=panels.get(name)||makePanel(name);
        const counts=getCounts(name);
        const signature=JSON.stringify(counts);

        if(item.signature!==signature){
            item.signature=signature;
            item.content.replaceChildren();

            for(const [id,count] of counts){
                item.content.appendChild(
                    createSkill(id,count)
                );
            }
        }

        item.panel.style.display='block';
        positionPanel(item.panel,block);
    });

    for(const [name,item] of panels){
        if(!visible.has(name)){
            item.panel.style.display='none';
        }
    }
}

function scan(){
    if(!running||busy)return;
    busy=true;

    try{
        readPlayers();
        readLog();
        render();
    }catch(error){
        console.error('lunarTracker:',error);
    }finally{
        busy=false;
    }
}

function getData(){
    const list=[...events.values()];

    const reconnaissance=[...players.values()].map(
        player=>{
            const own=list.filter(
                e=>e.player===player.name
            );

            const counts=getCounts(player.name);

            return {
                player:player.name,
                id:player.id,
                total:own.length,
                skills:counts.map(([id,count])=>({
                    id,
                    name:names.get(id)||'Умение '+id,
                    count
                }))
            };
        }
    );

    return {
        version:8,
        startedAt,
        stage,
        warning,
        players:[...players.values()],
        skills:Object.fromEntries(names),
        events:list,
        reconnaissance
    };
}

function destroy(){
    running=false;
    clearInterval(timer);
    observer?.disconnect();
    root.remove();
    if(window[KEY]?.version===8){
        delete window[KEY];
    }
}

window[KEY]={
    version:8,
    getData,
    destroy,
    stop:()=>{
        running=false;
        clearInterval(timer);
    },
    start:()=>{
        if(running)return;
        running=true;
        timer=setInterval(scan,350);
        scan();
    },
    show:render
};

if(previous?.events?.length){
    startedAt=Date.parse(previous.startedAt)||Date.now();

    for(const p of previous.players||[]){
        if(p.side==='enemies'){
            players.set(p.name,p);
        }
    }

    for(const [id,name] of Object.entries(
        previous.skills||{}
    )){
        names.set(Number(id),name);
    }

    const seen=new Map();

    for(const e of previous.events){
        if(!players.has(e.player))continue;

        const base=JSON.stringify([
            e.stage,e.player,e.skill,e.text
        ]);

        const n=(seen.get(base)||0)+1;
        seen.set(base,n);

        events.set(
            JSON.stringify([base,n]),
            {...e}
        );
    }
}

observer=new MutationObserver(()=>{
    if(running)scan();
});

observer.observe(
    document.querySelector('.lunar_log')||document.body,
    {childList:true,subtree:true,characterData:true}
);

timer=setInterval(scan,350);
scan();

console.log(
    '🚀 lunarTracker V8 запущен.',
    'Статистика отображается возле ракет противника.'
);

})();
